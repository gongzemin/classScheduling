{
  "bsonType": "object",
  "required": ["appid", "secret"], // 可以加上这行，要求这两个字段为必填
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "appid": {
      "type": "string",
      "description": "小程序的 AppID"
    },
    "secret": {
      "type": "string",
      "description": "小程序的 AppSecret"
    }
  }
}
